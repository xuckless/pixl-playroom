{
  "name": "pixl-playroom",
  "version": "0.3.0-beta",
  "description": "Pixl Playroom — a photo developer built on the PIXL engine.",
  "main": "./out/main/index.js",
  "author": "xuckless",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/xuckless/pixl-playroom.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && node scripts/build-native.mjs && electron-vite build && pnpm run notices && pnpm run release-notes",
    "build:native": "node scripts/build-native.mjs",
    "postinstall": "electron-builder install-app-deps",
    "notices": "node scripts/third-party-notices.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "publish-models": "node scripts/publish-models.mjs",
    "lens-profiles": "node scripts/lensfun-profiles.mjs",
    "doc-icons": "electron scripts/doc-icons.mjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win --x64",
    "build:mac:arm64": "pnpm run build && electron-builder --mac --arm64",
    "build:mac:x64": "pnpm run build && electron-builder --mac --x64",
    "test": "node --import ./tests/register.mjs --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xuckless/pixl-auto": "github:xuckless/pixl-engine#v0.19.1&path:/bindings/auto",
    "@xuckless/pixl-engine": "0.19.1",
    "@xuckless/pixl-models": "0.19.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^38.2.0",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/fiber": "^9.8.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@webgpu/types": "^0.1.74",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "motion": "^13.4.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zustand": "^5.0.8"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  }
}
